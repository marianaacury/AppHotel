<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource MidnightBlue}">
    <VerticalStackLayout
        VerticalOptions="CenterAndExpand"
        Padding="10">
        <Label 
            Text="Cálculo da Diária"
            TextColor="{StaticResource Primary}"
            FontFamily="KalamBold"
            FontSize="50"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            HorizontalTextAlignment="Center"/>

        <Frame Padding="10">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *, 2*">
                    <Label Grid.Row="0" Grid.Column="0" Text="Adultos:"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Value}" BindingContext="{x:Reference stp_Adulto}" />
                    <Stepper Grid.Row="0" Grid.Column="2" x:Name="stp_Adulto" Minimum="0" Maximum="10" Increment="1"/>

                    <Label Grid.Row="1" Grid.Column="0" Text="Crianças:"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value}" BindingContext="{x:Reference stp_Crianca}" />
                    <Stepper Grid.Row="1" Grid.Column="2" x:Name="stp_Crianca"  Minimum="0" Maximum="10" Increment="1"/>
                </Grid>

                <Label Text="Escolha sua Suíte:"/>
                <Picker x:Name="pck_quarto" Title="Selecione a sua acomodação"/>
                <Frame Padding="10" Margin="10">
                    <VerticalStackLayout>
                        <Label Text="Período da Estada:"/>
                        <HorizontalStackLayout>
                            <DatePicker x:Name="dtp_checkin" Date="{Binding CheckInDate}" />
                            <DatePicker x:Name="dtp_checkout" Date="{Binding CheckOutDate}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
                <Button Text="Avançar" />
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>