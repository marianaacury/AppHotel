<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    <VerticalStackLayout VerticalOptions="CenterAndExpand">
        <Label Text="{Binding QuartoSelecionado.Descricao}"
                TextColor="{StaticResource Primary}"
                FontFamily="KalamRegular"
                FontSize="50"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"/>

   

        <Border Stroke="{StaticResource Primary}" StrokeThickness="1" Padding="10" Margin="10">
            <VerticalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Número de Adultos"/>
                    <Label Text="{Binding QtdAdultos}" 
                           Margin="20,0,0,0"
                           TextColor="{StaticResource Primary}"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label Text="Número de Crianças"/>
                    <Label Text="{Binding QtdCriancas}" 
                           Margin="20,0,0,0"
                           TextColor="{StaticResource Primary}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Border Stroke="{StaticResource Primary}" StrokeThickness="1" Padding="10" Margin="10">
            <Grid ColumnDefinitions="*,*,*"
          RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in:"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out:"/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia:"/>

                <Label Grid.Row="1" Grid.Column="0" Text="{Binding DataCheckIn, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckOut, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Estadia}"/>
            </Grid>
        </Border>

        <Frame Padding="10" Margin="10">
            <VerticalStackLayout>
                <Label Text="Valor Total:"/>
                <Label Text="{Binding ValorTotal, StringFormat='R$ {0:N2}'}" 
                       FontSize="30"
                       FontFamily="KalamBold"
                       TextColor="{StaticResource Primary}"/>
            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Button_Clicked"/>
        



    </VerticalStackLayout>
</ContentPage>